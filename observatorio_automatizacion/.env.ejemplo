# Variables de entorno que necesita el servicio de n8n (y por lo tanto Python,
# que n8n ejecuta). NO subir el archivo real con credenciales a la página.

# Clave JSON de la cuenta de servicio de Google con permiso de EDITOR sobre el
# Sheet "BASE DE DATOS" (ID 1cVd_KBbtjMN8vUHlUks1IKwPf0c4Oq0RcYn4B5N5PkA).
GOOGLE_APPLICATION_CREDENTIALS=/opt/observatorio/credenciales/google_cuenta_servicio.json

# Zona horaria de los horarios de revisión (9:30, 11, 16:30 y 18:30).
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
TZ=America/Argentina/Buenos_Aires

# n8n 2.x: habilitar el nodo "Execute Command" (viene deshabilitado por defecto)
NODES_EXCLUDE=[]

# n8n: carpeta desde la que los nodos "Read file" pueden leer los resúmenes
N8N_RESTRICT_FILE_ACCESS_TO=/opt/observatorio/n8n-files

# Salida de Python en UTF-8 (acentos en los mensajes de Telegram)
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
